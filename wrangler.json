{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-project",
  "compatibility_date": "2026-10-21",
  "build": {
    "command": "bun run build"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": []
}
