# Mozilla Otari Gateway Configuration
# Copy to .env and fill in your values

# Otari Gateway base URL (hosted: https://otari.ai ; standalone: http://localhost:8000)
OTARI_BASE_URL=https://otari.ai

# Otari API key for authentication (keep secret, server-side only)
OTARI_API_KEY=your_otari_api_key_here

# Server port
PORT=3001

# CORS allowed origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Conversation history database path
DB_PATH=./data/conversations.sqlite
